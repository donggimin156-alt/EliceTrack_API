# .dockerignore

# 1. Byte-compiled / Cache files
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 2. Virtual Environments
venv/
.venv/
env/

# 3. Security / Local Configs
.env

# 4. Logs
*.log

# 5. Output / Artifacts (도커 내부에서 자체 생성하므로 복사 방지)
reports/
downloads/
dist/
build/
public/

# 6. Git and IDEs (빌드 불필요 파일)
.git/
.gitignore
.idea/
.vscode/
.DS_Store
Thumbs.db