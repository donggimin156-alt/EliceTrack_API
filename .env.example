# .env

# ==============================================================================
# 환경 변수 및 인프라 통합 설정 파일 (.env)
#
# [보안 주의 🚨]
# 이 파일에 실제 운영(PROD) 환경의 비밀번호나 API 키를 직접 입력하여 Git에 커밋하지 마세요!
# 로컬 테스트 용도로만 사용하며, CI/CD 환경에서는 파이프라인 Secret Variables로 덮어씁니다.
# (실무에서는 이 파일을 .env.example로 저장소에 올리고, .env는 .gitignore에 추가합니다.)
# ==============================================================================

# ------------------------------------------
# 1. 실행 환경 및 글로벌 타임아웃
# ------------------------------------------
# 실행 대상 환경 (dev, qa, stg, prod)
TEST_ENV=qa
UI_TIMEOUT=15
API_TIMEOUT=10

# ------------------------------------------
# 2. 데이터베이스 설정 (로컬/테스트 DB)
# ------------------------------------------
# 지원 드라이버: mysql+pymysql, postgresql+psycopg2 등
DB_DRIVER=mysql+pymysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=qa_admin
DB_PASSWORD=passw0rd
DB_NAME=qa_test_db

# ------------------------------------------
# 3. API 통신 인증 정보
# ------------------------------------------
REQRES_API_KEY=your_reqres_api_key_here

# ------------------------------------------
# 4. 글로벌 어드민 계정 정보 (UI 로그인 등)
# ------------------------------------------
GLOBAL_ADMIN_USER=admin_user
GLOBAL_ADMIN_PASS=super_secret_password

# ------------------------------------------
# 5. Slack Webhook 알림 연동
# ------------------------------------------
# 채널에 앱을 추가하고 발급받은 Webhook URL을 입력하세요.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ------------------------------------------
# 6. Jira 결함 티켓 자동 생성 연동
# ------------------------------------------
JIRA_BASE_URL=https://yourdomain.atlassian.net
JIRA_USER_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=QA
JIRA_ISSUE_TYPE=Bug

# 로컬 환경에서는 무분별한 이슈 생성을 막기 위해 false로 지정하고, CI/CD 파이프라인 스크립트에서만 true로 켭니다.
ENABLE_JIRA_AUTO_BUG=false