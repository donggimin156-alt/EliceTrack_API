# .env

# ==============================================================================
# 환경 변수 및 인프라 통합 설정 파일 (.env)
#
# [보안 주의 🚨]
# 이 파일에 실제 운영(PROD) 환경의 비밀번호나 API 키를 직접 입력하여 Git에 커밋하지 마세요!
# 로컬 테스트 용도로만 사용하며, CI/CD 환경에서는 파이프라인 Secret Variables로 덮어씁니다.
# (실무에서는 이 파일을 .env.example로 저장소에 올리고, .env는 .gitignore에 추가합니다.)
# ==============================================================================

# ------------------------------------------
# 1. 실행 환경 및 글로벌 타임아웃
# ------------------------------------------
# 실행 대상 환경 (dev, qa, stg, prod)
TEST_ENV=qa
UI_TIMEOUT=15
API_TIMEOUT=10

# ------------------------------------------
# 2. 데이터베이스 설정 (로컬/테스트 DB)
# ------------------------------------------
# 지원 드라이버: mysql+pymysql, postgresql+psycopg2 등
DB_DRIVER=mysql+pymysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=qa_admin
DB_PASSWORD=passw0rd
DB_NAME=qa_test_db

# ------------------------------------------
# 3. API 통신 인증 정보
# ------------------------------------------
REQRES_API_KEY=your_reqres_api_key_here

# ------------------------------------------
# 4. 글로벌 어드민 계정 정보 (UI 로그인 등)
# ------------------------------------------
GLOBAL_ADMIN_USER=admin_user
GLOBAL_ADMIN_PASS=super_secret_password

# ------------------------------------------
# 5. Slack Webhook 알림 연동
# ------------------------------------------
# 채널에 앱을 추가하고 발급받은 Webhook URL을 입력하세요.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ------------------------------------------
# 6. Jira 결함 티켓 자동 생성 연동
# ------------------------------------------
JIRA_BASE_URL=https://yourdomain.atlassian.net
JIRA_USER_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=QA
JIRA_ISSUE_TYPE=Bug

# 로컬 환경에서는 무분별한 이슈 생성을 막기 위해 false로 지정하고, CI/CD 파이프라인 스크립트에서만 true로 켭니다.
ENABLE_JIRA_AUTO_BUG=false

# ------------------------------------------
# 7. Elice QA 프로젝트 — 게시판(Board) API 테스트
# ------------------------------------------
# 실행 대상 환경: dev | prod
TARGET=dev
ELICE_API_TIMEOUT=10

# [dev] 학습자 계정
LEARNER_LOGIN_ID=your_learner@example.com
LEARNER_PASSWORD=your_learner_password

# [dev] 교육자(기관 관리자) 계정
EDUCATOR_LOGIN_ID=your_educator@example.com
EDUCATOR_PASSWORD=your_educator_password

# [prod] 학습자 — 카카오 로그인이라 /login/pw 불가, 브라우저 쿠키의 access_token 직접 입력
# PROD_LEARNER_TOKEN=
LEARNER_TOKEN=여기에_브라우저에서_복사한_access_token_붙여넣기

# (선택) 환경별 리소스 ID override
# DEV_CLASSROOM_ID=22e01595-3c49-4605-8239-fe3473cd7e07
# DEV_BOARD_ID=1
# DEV_OTHERS_ARTICLE_ID=1
# PROD_CLASSROOM_ID=a647c7c0-1e15-4196-97fd-d6e4dea84b2c
# PROD_BOARD_ID=10187
# PROD_OTHERS_ARTICLE_ID=78933