# Local environment template — copy to .env and fill with your values
# NOTE: .env and .env.* are gitignored; do NOT commit secrets.

# If you want to run prod learner-specific tests, set your learner account id below:
PROD_LEARNER_ACCOUNT_ID=

# Dev tokens to bypass login for local development (optional)
DEV_EDUCATOR_TOKEN=
DEV_LEARNER_TOKEN=

# Other helpful placeholders
#TARGET=dev
#API_TIMEOUT=10
#SCRIPT_TIMEOUT=30
