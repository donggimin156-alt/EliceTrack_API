<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="QA5_부하테스트_SANDBOX">
      <stringProp name="TestPlan.comments">하드 리밋: 최대 30명 동시접속 / Ramp-up 60~90초(5-&gt;10-&gt;20-&gt;30 단계, 단계별 증설 필수) / Loop Count 최대 3회(Infinite 금지) / 매 요청 후 Uniform Random Timer 3~5초 적용 / QA 전용 Sandbox 과목(course_id=62, lecture_id=179, lecture_page_id=198, material_quiz_id=198) 전용. 실행 전 CSV 경로, COURSE_ID/LECTURE_ID/LECTURE_PAGE_ID/MATERIAL_QUIZ_ID, RETRY_LOOPS 값을 반드시 확인할 것.</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">PROTOCOL</stringProp>
            <stringProp name="Argument.value">https</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="HOST_ACCOUNT" elementType="Argument">
            <stringProp name="Argument.name">HOST_ACCOUNT</stringProp>
            <stringProp name="Argument.value">dev-qatrack-account-api.dev.elicer.io</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="HOST_API" elementType="Argument">
            <stringProp name="Argument.name">HOST_API</stringProp>
            <stringProp name="Argument.value">dev-qatrack-api.dev.elicer.io</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="HOST_ACTIVITY" elementType="Argument">
            <stringProp name="Argument.name">HOST_ACTIVITY</stringProp>
            <stringProp name="Argument.value">dev-qatrack-activity-api.dev.elicer.io</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ORG" elementType="Argument">
            <stringProp name="Argument.name">ORG</stringProp>
            <stringProp name="Argument.value">academy</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ORG_ID" elementType="Argument">
            <stringProp name="Argument.name">ORG_ID</stringProp>
            <stringProp name="Argument.value">1</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="COURSE_ID" elementType="Argument">
            <stringProp name="Argument.name">COURSE_ID</stringProp>
            <stringProp name="Argument.value">62</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="LECTURE_ID" elementType="Argument">
            <stringProp name="Argument.name">LECTURE_ID</stringProp>
            <stringProp name="Argument.value">179</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="LECTURE_PAGE_ID" elementType="Argument">
            <stringProp name="Argument.name">LECTURE_PAGE_ID</stringProp>
            <stringProp name="Argument.value">198</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="MATERIAL_QUIZ_ID" elementType="Argument">
            <stringProp name="Argument.name">MATERIAL_QUIZ_ID</stringProp>
            <stringProp name="Argument.value">198</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RETRY_LOOPS" elementType="Argument">
            <stringProp name="Argument.name">RETRY_LOOPS</stringProp>
            <stringProp name="Argument.value">3</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
